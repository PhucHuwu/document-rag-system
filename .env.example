NODE_ENV=development

# Public web
NEXT_PUBLIC_API_URL=http://localhost:3001

# Core Backend
API_PORT=3001
DATABASE_URL=postgresql://tina:tina@localhost:5432/tina_chatbot
REDIS_URL=redis://localhost:6379
AI_BACKEND_URL=http://localhost:8000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# Internal service auth (shared secret between Core Backend and AI Backend)
INTERNAL_API_KEY=change-me-internal-key

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tina-documents

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=tina_chunks

# AI Backend
AI_PORT=8000
CORE_BACKEND_URL=http://localhost:3001
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Tina Chatbot
OPENROUTER_SITE_URL=http://localhost:3000

# Embedding (self-hosted BAAI/bge-m3)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Reranker (Cohere) - leave COHERE_API_KEY empty to disable reranking
COHERE_API_KEY=
RERANKER_MODEL=rerank-multilingual-v3.0

# LLM + chunking
LLM_MODEL=openai/gpt-4.1-mini
CHUNK_SIZE=800
CHUNK_OVERLAP=120
